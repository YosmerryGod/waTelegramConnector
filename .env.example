# Telegram
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://chat.doodweb.tech
TELEGRAM_MESSAGE_LIMIT=4000
MAX_MEDIA_MB=45

# Mini App API
MINIAPP_API_HOST=127.0.0.1
MINIAPP_API_PORT=3000
MINIAPP_AUTH_MAX_AGE_SECONDS=86400

# WhatsApp / Baileys
WHATSAPP_AUTH_DIR=./auth
WHATSAPP_MEDIA_DIR=./data/media
RECONNECT_DELAY_MS=3000
MAX_RECONNECT_DELAY_MS=60000
WA_CONNECT_TIMEOUT_MS=30000
WA_KEEPALIVE_MS=25000
DISCONNECT_NOTICE_DELAY_MS=45000
DEFAULT_COUNTRY_CODE=

# Database
SQLITE_PATH=./data/bridge.db
ADMIN_TELEGRAM_IDS=

# Application
LOG_LEVEL=warn
FREE_PAUSE_HOUR=8
WAGRAM_AUTO_REPLY_SETTLE_MS=5000

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_SITE_URL=https://wagram.app
OPENROUTER_APP_NAME=WAGRAM
WAGRAM_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Optional integrations / diagnostics
DANA_PAYMENT_MONITOR_API_KEY=
CALL_DEBUG=false
